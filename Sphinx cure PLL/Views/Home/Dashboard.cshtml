@{
    ViewData["Title"] = "Dashboard";
    Layout = null; // This page handles its own layout
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sphinx Cure</title>
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />
    
    <!-- Dashboard CSS -->
    <link rel="stylesheet" href="~/css/dashboard.css" />
    
    <style>
        /* Additional inline styles if needed */
        body {
            overflow-x: hidden;
        }
    </style>
</head>
<body>
    <!-- Sidebar Wrapper (FIXED: This is now separate from content) -->
    <div class="sidebar-wrapper" id="sidebarWrapper">
        <div class="sidebar">
            <!-- Logo -->
            <div class="sidebar-header text-center py-4">
                <img src="~/img/logo.jpg" alt="Sphinx Cure Medical Clinic Logo" class="sidebar-logo">
                <h4 class="sidebar-title mt-3 mb-0">Sphinx Cure</h4>
                <p class="text-muted small">Medical Clinic</p>
            </div>

                        <!-- Top Navigation Bar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
                <div class="container-fluid">
                    <!-- Toggle Button for Sidebar -->
                    <button class="btn btn-light d-none d-lg-block" id="sidebarToggleDesktop">
                        <i class="fas fa-bars"></i>
                    </button>

                    <div class="navbar-nav ms-auto">
                        <!-- Notifications Dropdown -->
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-bell me-2"></i>
                                <span class="badge bg-danger">3</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <h6 class="dropdown-header">Notifications</h6>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-user-plus text-success me-2"></i>
                                    New patient registered
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                                    Appointment reminder
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-file-medical text-warning me-2"></i>
                                    Report ready
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- User Profile -->
            <div class="sidebar-footer mt-auto">
                <div class="user-profile">
                    <div class="user-avatar">
                        <i class="fas fa-user-md"></i>
                    </div>
                    <div class="user-info">
                        <h6 class="mb-0">Welcome, Doctor</h6>
                        <small class="text-muted">Administrator</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area (FIXED: This starts after sidebar) -->
    <div class="main-content" id="mainContent">
        <!-- Top Navigation Bar -->
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
            <div class="container-fluid">
                <div class="navbar-nav ms-auto">
                    <div class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-bell me-2"></i>
                            <span class="badge bg-danger">3</span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <h6 class="dropdown-header">Notifications</h6>
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-user-plus text-success me-2"></i>
                                New patient registered
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="fas fa-calendar-alt text-primary me-2"></i>
                                Appointment reminder
                            </a>
                        </div>
                    </div>
                    
                    <!-- Theme Toggle Button -->
                        <div class="nav-item">
                            <button class="theme-toggle" id="themeToggle" title="Toggle dark/light mode">
                                <i class="fas fa-moon"></i>
                                <i class="fas fa-sun"></i>
                            </button>
                        </div>

                    <div class="nav-item ms-3">
                        <a href="@Url.Action("SignOut", "Account")" class="btn btn-outline-danger btn-sm">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Dashboard Content -->
        <main class="container-fluid py-4">
            <!-- Welcome Banner -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="welcome-banner">
                        <div class="row align-items-center">
                            <div class="col-md-8">
                                <h1 class="mb-2">Welcome to Sphinx Cure Dashboard</h1>
                                <p class="text-muted mb-0">Manage patients, appointments, and medical records efficiently.</p>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <div class="current-time">
                                    <i class="fas fa-clock me-2"></i>
                                    <span id="currentTime">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Statistics Cards -->
            <div class="row g-4 mb-4">
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card stat-card-primary">
                        <div class="stat-icon">
                            <i class="fas fa-user-injured"></i>
                        </div>
                        <div class="stat-content">
                            <h3>@ViewBag.PatientCount</h3>
                            <p>Total Patients</p>
                            <small class="text-success">
                                <i class="fas fa-arrow-up me-1"></i> 12% increase
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card stat-card-success">
                        <div class="stat-icon">
                            <i class="fas fa-heartbeat"></i>
                        </div>
                        <div class="stat-content">
                            <h3>@(ViewBag.ActivePatients ?? 0)</h3>
                            <p>Active Patients</p>
                            <small class="text-success">
                                <i class="fas fa-arrow-up me-1"></i> 8% increase
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card stat-card-info">
                        <div class="stat-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <div class="stat-content">
                            <h3>@(ViewBag.TodaysAppointments ?? 0)</h3>
                            <p>Today's Appointments</p>
                            <small class="text-warning">
                                <i class="fas fa-clock me-1"></i> 2 pending
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="stat-card stat-card-warning">
                        <div class="stat-icon">
                            <i class="fas fa-file-medical-alt"></i>
                        </div>
                        <div class="stat-content">
                            <h3>@(ViewBag.RecentPatients?.Count ?? 0)</h3>
                            <p>Recent Additions</p>
                            <small class="text-info">
                                Last 7 days
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 pb-0">
                            <h5 class="mb-0">
                                <i class="fas fa-bolt text-warning me-2"></i> Quick Actions
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row g-3">
                                <div class="col-xl-2 col-md-4 col-sm-6">
                                    <a href="@Url.Action("Create", "Patient")" class="quick-action-btn">
                                        <div class="icon-wrapper bg-primary">
                                            <i class="fas fa-user-plus"></i>
                                        </div>
                                        <span>Add Patient</span>
                                    </a>
                                </div>
                                <div class="col-xl-2 col-md-4 col-sm-6">
                                    <a href="@Url.Action("Index", "Patient")" class="quick-action-btn">
                                        <div class="icon-wrapper bg-success">
                                            <i class="fas fa-list"></i>
                                        </div>
                                        <span>View All</span>
                                    </a>
                                </div>
                                <div class="col-xl-2 col-md-4 col-sm-6">
                                    <a href="@Url.Action("SearchNames", "Patient")" class="quick-action-btn">
                                        <div class="icon-wrapper bg-info">
                                            <i class="fas fa-search"></i>
                                        </div>
                                        <span>Search</span>
                                    </a>
                                </div>
                                <div class="col-xl-2 col-md-4 col-sm-6">
                                    <a href="#" class="quick-action-btn">
                                        <div class="icon-wrapper bg-warning">
                                            <i class="fas fa-calendar-plus"></i>
                                        </div>
                                        <span>New Appointment</span>
                                    </a>
                                </div>
                                <div class="col-xl-2 col-md-4 col-sm-6">
                                    <a href="#" class="quick-action-btn">
                                        <div class="icon-wrapper bg-danger">
                                            <i class="fas fa-file-pdf"></i>
                                        </div>
                                        <span>Generate Report</span>
                                    </a>
                                </div>
                                <div class="col-xl-2 col-md-4 col-sm-6">
                                    <a href="#" class="quick-action-btn">
                                        <div class="icon-wrapper bg-secondary">
                                            <i class="fas fa-chart-bar"></i>
                                        </div>
                                        <span>Analytics</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Patients -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">
                                <i class="fas fa-history text-primary me-2"></i> Recent Patients
                            </h5>
                            <a href="@Url.Action("Index", "Patient")" class="btn btn-sm btn-outline-primary">
                                View All <i class="fas fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Patient Name</th>
                                            <th>Registration Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (ViewBag.RecentPatients != null && ViewBag.RecentPatients.Count > 0)
                                        {
                                            @foreach (var patient in ViewBag.RecentPatients)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="d-flex align-items-center">
                                                            <div class="patient-avatar me-3">
                                                                <i class="fas fa-user"></i>
                                                            </div>
                                                            <div>
                                                                <strong>@patient.Name</strong>
                                                                <div class="text-muted small">ID: @patient.Id</div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <small>@DateTime.Now.AddDays(-ViewBag.RecentPatients.IndexOf(patient)).ToString("MMM dd, yyyy")</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-success">Active</span>
                                                    </td>
                                                    <td>
                                                        <div class="btn-group btn-group-sm">
                                                            <a href="@Url.Action("Details", "Patient", new { id = patient.Id })" class="btn btn-outline-info" title="View Details">
                                                                <i class="fas fa-eye"></i>
                                                            </a>
                                                            <a href="@Url.Action("UpdateFile", "Patient", new { id = patient.Id })" class="btn btn-outline-warning" title="Update File">
                                                                <i class="fas fa-edit"></i>
                                                            </a>
                                                            @if (!string.IsNullOrEmpty(patient.FilePath))
                                                            {
                                                                <a href="@Url.Action("DownloadFile", "Patient", new { id = patient.Id })" class="btn btn-outline-success" title="Download File">
                                                                    <i class="fas fa-download"></i>
                                                                </a>
                                                            }
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center py-4">
                                                    <div class="empty-state">
                                                        <i class="fas fa-user-injured fa-3x text-muted mb-3"></i>
                                                        <h5>No patients found</h5>
                                                        <p class="text-muted">Start by adding your first patient</p>
                                                        <a href="@Url.Action("Create", "Patient")" class="btn btn-primary">
                                                            <i class="fas fa-user-plus me-2"></i> Add Patient
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Bootstrap JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Dashboard JavaScript -->
    <script src="~/js/dashboard.js"></script>
</body>
</html>