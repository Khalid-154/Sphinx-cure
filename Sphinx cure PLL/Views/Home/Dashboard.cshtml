@{
    ViewData["Title"] = "Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sphinx Cure</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <!-- Animate.css for animations -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <!-- Dashboard CSS -->
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>
<body>
    <div class="layout-container">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <!-- Sidebar Header -->
            <div class="sidebar-header">
                <div class="clinic-logo">
                    <img src="~/img/logo.jpg" alt="Sphinx Cure Logo" class="clinic-logo-img">
                </div>
                <h2 class="clinic-name">Sphinx Cure</h2>

                <div class="user-profile-header">
                    <div class="user-avatar-header">
                        <i class="fas fa-user-md"></i>
                    </div>
                    <div class="user-info-header">
                        <h6 class="mb-0">@(ViewBag.CurrentUserName ?? "User")</h6>
                        <small class="text-muted">@(ViewBag.CurrentUserRole ?? "Role")</small>
                    </div>
                </div>
            </div>

            <!-- Sidebar Menu -->
            <nav class="sidebar-menu">
                <a href="@Url.Action("Dashboard", "Home")" class="menu-item active" data-tooltip="Dashboard">
                    <div class="menu-icon">
                        <i class="fas fa-tachometer-alt"></i>
                    </div>
                    <span class="menu-text">Dashboard</span>
                </a>

                <a href="@Url.Action("Index", "Patient")" class="menu-item" data-tooltip="Patients">
                    <div class="menu-icon">
                        <i class="fas fa-user-injured"></i>
                    </div>
                    <span class="menu-text">Patients</span>
                    <span class="menu-badge">@ViewBag.PatientCount</span>
                </a>

                <a href="#" class="menu-item" data-tooltip="Appointments">
                    <div class="menu-icon">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <span class="menu-text">Appointments</span>
                    <span class="menu-badge">@(ViewBag.TodaysAppointments ?? 0)</span>
                </a>

                <a href="#" class="menu-item" data-tooltip="Medical Records">
                    <div class="menu-icon">
                        <i class="fas fa-file-medical-alt"></i>
                    </div>
                    <span class="menu-text">Medical Records</span>
                </a>

                <a href="#" class="menu-item" data-tooltip="Reports">
                    <div class="menu-icon">
                        <i class="fas fa-chart-bar"></i>
                    </div>
                    <span class="menu-text">Reports & Analytics</span>
                </a>

                @if (User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Index", "UserManagement")" class="menu-item" data-tooltip="User Management">
                        <div class="menu-icon">
                            <i class="fas fa-users-cog"></i>
                        </div>
                        <span class="menu-text">User Management</span>
                    </a>
                }

                <a href="#" class="menu-item" data-tooltip="Settings">
                    <div class="menu-icon">
                        <i class="fas fa-cog"></i>
                    </div>
                    <span class="menu-text">Settings</span>
                </a>

                <a href="#" class="menu-item" data-tooltip="Help">
                    <div class="menu-icon">
                        <i class="fas fa-question-circle"></i>
                    </div>
                    <span class="menu-text">Help & Support</span>
                </a>
            </nav>

            <!-- Sidebar Footer with Logout Button -->
            <div class="sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form">
                    <button type="submit" class="logout-btn">
                        <i class="fas fa-sign-out-alt"></i>
                        <span class="logout-text">Logout</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="main-content">
            <!-- Top Navigation Bar -->
            <nav class="top-navbar">
                <div class="container-fluid d-flex align-items-center">

                    <!-- Page Title -->
                    <h4 class="mb-0 d-none d-lg-block">Dashboard</h4>

                    <div class="d-flex align-items-center ms-auto">
                        <!-- Notifications Dropdown -->
                        <div class="dropdown me-3">
                            <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-bell me-2"></i>
                                <span class="badge bg-danger">3</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                <h6 class="dropdown-header">Notifications</h6>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-user-plus text-success me-2"></i>
                                    New patient registered
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-calendar-alt text-primary me-2"></i>
                                    Appointment reminder
                                </a>
                                <a class="dropdown-item" href="#">
                                    <i class="fas fa-file-medical text-warning me-2"></i>
                                    Report ready
                                </a>
                            </div>
                        </div>

                        <!-- Theme Toggle -->
                        <div class="me-3">
                            <button class="theme-toggle" id="themeToggle" title="Toggle dark/light mode">
                                <i class="fas fa-moon d-none"></i>
                                <i class="fas fa-sun"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Dashboard Content -->
            <div class="content-wrapper">
                <!-- Welcome Banner -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="welcome-banner animate__animated animate__fadeIn">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h1 class="mb-2">Welcome to Sphinx Cure</h1>
                                    <p class="mb-0">Hello, @(ViewBag.CurrentUserName ?? "User")! Here's what's happening today.</p>
                                </div>
                                <div class="col-md-4 text-md-end">
                                    <div class="current-time">
                                        <i class="fas fa-clock me-2"></i>
                                        <span id="currentTime">@DateTime.Now.ToString("dddd, MMMM dd, yyyy HH:mm")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Statistics Cards -->
                <div class="row g-4 mb-4">
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card stat-card-primary">
                            <div class="stat-icon">
                                <i class="fas fa-user-injured"></i>
                            </div>
                            <div class="stat-content">
                                <h3>@ViewBag.PatientCount</h3>
                                <p>Total Patients</p>
                                <small class="text-success">
                                    <i class="fas fa-arrow-up me-1"></i> 12% increase
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card stat-card-success">
                            <div class="stat-icon">
                                <i class="fas fa-heartbeat"></i>
                            </div>
                            <div class="stat-content">
                                <h3>@(ViewBag.ActivePatients ?? 0)</h3>
                                <p>Active Patients</p>
                                <small class="text-success">
                                    <i class="fas fa-arrow-up me-1"></i> 8% increase
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card stat-card-info">
                            <div class="stat-icon">
                                <i class="fas fa-calendar-check"></i>
                            </div>
                            <div class="stat-content">
                                <h3>@(ViewBag.TodaysAppointments ?? 0)</h3>
                                <p>Today's Appointments</p>
                                <small class="text-warning">
                                    <i class="fas fa-clock me-1"></i> 2 pending
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="col-xl-3 col-md-6">
                        <div class="stat-card stat-card-warning">
                            <div class="stat-icon">
                                <i class="fas fa-file-medical-alt"></i>
                            </div>
                            <div class="stat-content">
                                <h3>@(ViewBag.RecentPatientsCount ?? (ViewBag.RecentPatients != null ? ViewBag.RecentPatients.Count : 0))</h3>
                                <p>Recent Additions</p>
                                <small class="text-info">
                                    Last 7 days
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Patients -->
                <div class="row">
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header border-0 d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="fas fa-history text-primary me-2"></i> Recent Patients
                                </h5>
                                <a href="@Url.Action("Index", "Patient")" class="btn btn-sm btn-outline-primary">
                                    View All <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Patient Name</th>
                                                <th>Registration Date</th>
                                                <th>Status</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var recentPatients = ViewBag.RecentPatients as List<dynamic>;
                                            }
                                            @if (recentPatients != null && recentPatients.Count > 0)
                                            {
                                                foreach (var patient in recentPatients)
                                                {
                                                    <tr>
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                <div class="patient-avatar me-3">
                                                                    <i class="fas fa-user"></i>
                                                                </div>
                                                                <div>
                                                                    <strong>@(patient.Name ?? "N/A")</strong>
                                                                    <div class="text-muted small">ID: @(patient.Id ?? "N/A")</div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            @if (patient.RegistrationDate != null)
                                                            {
                                                                <small>@(patient.RegistrationDate.ToString("MMM dd, yyyy"))</small>
                                                            }
                                                            else if (patient.CreatedDate != null)
                                                            {
                                                                <small>@(patient.CreatedDate.ToString("MMM dd, yyyy"))</small>
                                                            }
                                                            else
                                                            {
                                                                <small>N/A</small>
                                                            }
                                                        </td>
                                                        <td>
                                                            @{
                                                                var status = patient.Status?.ToString() ?? "Active";
                                                                var badgeClass = status == "Active" ? "bg-success" :
                                                                status == "Inactive" ? "bg-secondary" :
                                                                status == "Pending" ? "bg-warning" : "bg-info";
                                                            }
                                                            <span class="badge @badgeClass">@status</span>
                                                        </td>
                                                        <td>
                                                            <div class="btn-group btn-group-sm">
                                                                @if (patient.Id != null)
                                                                {
                                                                    <a href="@Url.Action("Details", "Patient", new { id = patient.Id })" class="btn btn-outline-info" title="View Details">
                                                                        <i class="fas fa-eye"></i>
                                                                    </a>
                                                                    <a href="@Url.Action("UpdateFile", "Patient", new { id = patient.Id })" class="btn btn-outline-warning" title="Update File">
                                                                        <i class="fas fa-edit"></i>
                                                                    </a>
                                                                    @if (!string.IsNullOrEmpty(patient.FilePath?.ToString()))
                                                                    {
                                                                        <a href="@Url.Action("DownloadFile", "Patient", new { id = patient.Id })" class="btn btn-outline-success" title="Download File">
                                                                            <i class="fas fa-download"></i>
                                                                        </a>
                                                                    }
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="4" class="text-center py-4">
                                                        <div class="empty-state">
                                                            <i class="fas fa-user-injured fa-3x text-muted mb-3"></i>
                                                            <h5>No patients found</h5>
                                                            <p class="text-muted">Start by adding your first patient</p>
                                                            <a href="@Url.Action("Create", "Patient")" class="btn btn-primary">
                                                                <i class="fas fa-user-plus me-2"></i> Add Patient
                                                            </a>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Dashboard JS -->
    <script src="~/js/dashboard.js"></script>
</body>
</html>