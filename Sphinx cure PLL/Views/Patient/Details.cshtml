@using Sphinx_cure_.BLL.ModelVM.Patient
@model PatientDTO

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Patient Details - @(Model?.Name ?? "Unknown")</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #2c5aa0 0%, #1e3a5f 50%, #0d1b2a 100%);
            min-height: 100vh;
            overflow-x: hidden;
            position: relative;
        }

        /* Animated background particles */
        .particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        .particle {
            position: absolute;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0.7;
        }

            .particle:nth-child(odd) {
                background: rgba(79, 172, 254, 0.15);
            }

            .particle:nth-child(even) {
                background: rgba(67, 206, 162, 0.12);
            }

            .particle.floating-up {
                transform: translateY(-20px) scale(1.1);
                opacity: 1;
            }

            .particle.floating-down {
                transform: translateY(20px) scale(0.9);
                opacity: 0.4;
            }

        /* Main container */
        .main-container {
            position: relative;
            z-index: 10;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .details-container {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            border: 2px solid rgba(79, 172, 254, 0.2);
            border-radius: 24px;
            padding: 40px;
            width: 100%;
            max-width: 800px;
            box-shadow: 0 20px 60px rgba(44, 90, 160, 0.15), inset 0 1px 0 rgba(255, 255, 255, 0.9);
            position: relative;
            overflow: hidden;
            transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            transform: translateY(50px) scale(0.95);
        }

            .details-container.loaded {
                opacity: 1;
                transform: translateY(0) scale(1);
            }

            .details-container:hover {
                transform: translateY(-8px) scale(1.01);
                box-shadow: 0 35px 90px rgba(44, 90, 160, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.9);
                border-color: rgba(79, 172, 254, 0.4);
            }

            .details-container::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, #2c5aa0, #4facfe, #00f2fe, #43cea2, #185a9d);
                transition: all 1.2s cubic-bezier(0.4, 0, 0.2, 1);
            }

            .details-container:hover::before {
                left: 0;
            }

        /* Page title */
        .page-title {
            text-align: center;
            color: #2c5aa0;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 20px;
            position: relative;
            text-shadow: 0 2px 4px rgba(44, 90, 160, 0.1);
            transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            transform: translateY(-30px);
        }

            .page-title.loaded {
                opacity: 1;
                transform: translateY(0);
            }

            .page-title:hover {
                color: #185a9d;
                transform: scale(1.05) translateY(-5px);
                text-shadow: 0 4px 8px rgba(44, 90, 160, 0.2);
            }

        /* Patient name header */
        .patient-name {
            text-align: center;
            color: #4facfe;
            font-size: 2rem;
            font-weight: 600;
            margin-bottom: 30px;
            position: relative;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            transform: translateY(20px);
        }

            .patient-name.loaded {
                opacity: 1;
                transform: translateY(0);
            }

            .patient-name:hover {
                color: #43cea2;
                transform: scale(1.03);
            }

        /* Divider */
        .divider {
            height: 2px;
            background: linear-gradient(90deg, transparent, #4facfe, transparent);
            margin: 20px 0;
            border-radius: 1px;
            transition: all 0.5s ease;
            opacity: 0;
            transform: scaleX(0);
        }

            .divider.loaded {
                opacity: 1;
                transform: scaleX(1);
            }

        /* Details list styling */
        .details-list {
            margin: 30px 0;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            transform: translateY(30px);
        }

            .details-list.loaded {
                opacity: 1;
                transform: translateY(0);
            }

        .detail-row {
            display: flex;
            align-items: center;
            margin-bottom: 25px;
            padding: 20px;
            background: rgba(79, 172, 254, 0.05);
            border-radius: 16px;
            border: 1px solid rgba(79, 172, 254, 0.1);
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

            .detail-row:hover {
                background: rgba(79, 172, 254, 0.1);
                border-color: rgba(79, 172, 254, 0.3);
                transform: translateX(10px) scale(1.01);
                box-shadow: 0 8px 25px rgba(79, 172, 254, 0.15);
            }

            .detail-row::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                width: 4px;
                height: 100%;
                background: linear-gradient(180deg, #4facfe, #43cea2);
                transition: all 0.3s ease;
                opacity: 0;
            }

            .detail-row:hover::before {
                opacity: 1;
            }

        .detail-label {
            font-weight: 600;
            color: #2c5aa0;
            min-width: 120px;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            transition: all 0.3s ease;
        }

            .detail-label:hover {
                color: #185a9d;
                transform: translateX(5px);
            }

        .detail-value {
            flex: 1;
            color: #1e3a5f;
            font-size: 1rem;
            margin-left: 20px;
            transition: all 0.3s ease;
        }

            .detail-value:hover {
                color: #2c5aa0;
            }

        /* Medical icons */
        .medical-icon {
            color: #4facfe;
            margin-right: 10px;
            font-size: 1.3rem;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

            .medical-icon:hover {
                color: #43cea2;
                transform: rotate(360deg) scale(1.2);
                text-shadow: 0 0 15px rgba(79, 172, 254, 0.8);
            }

        /* Button styling */
        .btn-container {
            display: flex;
            gap: 20px;
            margin-top: 40px;
            justify-content: center;
            flex-wrap: wrap;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            opacity: 0;
            transform: translateY(30px);
        }

            .btn-container.loaded {
                opacity: 1;
                transform: translateY(0);
            }

        .btn {
            padding: 16px 32px;
            border: none;
            border-radius: 16px;
            font-size: 1.1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 150px;
        }

            .btn::before {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
                transition: all 0.6s ease;
            }

            .btn:hover::before {
                left: 100%;
            }

        .btn-success {
            background: linear-gradient(135deg, #43cea2 0%, #185a9d 100%);
            color: white;
            box-shadow: 0 8px 25px rgba(67, 206, 162, 0.4);
        }

            .btn-success:hover {
                transform: translateY(-3px) scale(1.05);
                box-shadow: 0 15px 35px rgba(67, 206, 162, 0.6);
                background: linear-gradient(135deg, #185a9d 0%, #4facfe 100%);
            }

        .btn-secondary {
            background: rgba(44, 90, 160, 0.1);
            color: #2c5aa0;
            border: 2px solid rgba(44, 90, 160, 0.3);
        }

            .btn-secondary:hover {
                background: rgba(44, 90, 160, 0.2);
                transform: translateY(-2px) scale(1.03);
                border-color: #2c5aa0;
                box-shadow: 0 10px 25px rgba(44, 90, 160, 0.2);
            }

        .btn:active {
            transform: translateY(0) scale(1);
            transition: all 0.1s ease;
        }

        /* No file message */
        .no-file-message {
            color: #6c757d;
            font-style: italic;
            background: rgba(108, 117, 125, 0.1);
            padding: 12px 20px;
            border-radius: 12px;
            border: 1px solid rgba(108, 117, 125, 0.2);
            transition: all 0.3s ease;
        }

            .no-file-message:hover {
                background: rgba(108, 117, 125, 0.15);
                transform: scale(1.02);
            }

        /* Wave effect */
        .wave-effect {
            position: relative;
            overflow: hidden;
        }

            .wave-effect::after {
                content: '';
                position: absolute;
                top: 0;
                left: -100%;
                width: 100%;
                height: 100%;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
                transition: all 0.8s ease;
            }

            .wave-effect.active::after {
                left: 100%;
            }

        /* Pulse effect */
        .pulse-effect {
            transition: all 0.3s ease;
        }

            .pulse-effect:hover {
                box-shadow: 0 0 20px rgba(79, 172, 254, 0.4);
            }

        /* File download icon animation */
        .download-icon {
            margin-right: 8px;
            transition: all 0.3s ease;
        }

        .btn-success:hover .download-icon {
            transform: translateY(-2px);
        }

        /* Loading animation for buttons */
        .btn-loading {
            pointer-events: none;
            opacity: 0.7;
        }

            .btn-loading::after {
                content: '';
                position: absolute;
                width: 16px;
                height: 16px;
                border: 2px solid transparent;
                border-top: 2px solid currentColor;
                border-radius: 50%;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                transition: transform 0.05s linear;
            }

        /* Success and error states */
        .btn-success-state {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%) !important;
        }

        .btn-error-state {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%) !important;
        }

        /* Error messages */
        .error-message {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid rgba(220, 53, 69, 0.2);
            margin-bottom: 20px;
            text-align: center;
        }

        /* Success messages */
        .success-message {
            background: rgba(40, 167, 69, 0.1);
            color: #28a745;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid rgba(40, 167, 69, 0.2);
            margin-bottom: 20px;
            text-align: center;
        }

        /* File info styling */
        .file-info {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .file-size {
            font-size: 0.9rem;
            color: #6c757d;
            background: rgba(108, 117, 125, 0.1);
            padding: 4px 8px;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="particles"></div>

    <div class="main-container">
        <div class="details-container" id="detailsContainer">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="error-message">
                    <i class="fas fa-exclamation-triangle"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="success-message">
                    <i class="fas fa-check-circle"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            <h2 class="page-title" id="pageTitle">
                <i class="fas fa-user-circle medical-icon"></i>
                Patient Details
            </h2>

            <h4 class="patient-name" id="patientName">
                @(Model?.Name ?? "Unknown Patient")
            </h4>

            <div class="divider" id="divider"></div>

            <dl class="details-list" id="detailsList">
                <div class="detail-row wave-effect" id="nameRow">
                    <dt class="detail-label">
                        <i class="fas fa-user medical-icon"></i>
                        Full Name
                    </dt>
                    <dd class="detail-value">@(Model?.Name ?? "Not specified")</dd>
                </div>

                <div class="detail-row wave-effect" id="fileRow">
                    <dt class="detail-label">
                        <i class="fas fa-file-medical medical-icon"></i>
                        Medical File
                    </dt>
                    <dd class="detail-value" id="fileValue">
                        @if (!string.IsNullOrEmpty(Model?.FilePath))
                        {
                            <div class="file-info">
                                <button class="btn btn-success pulse-effect" onclick="downloadFile(@Model.Id)" id="downloadBtn">
                                    <i class="fas fa-download download-icon"></i>
                                    Download File
                                </button>

                                <button class="btn btn-primary pulse-effect" onclick="viewFile(@Model.Id)" id="viewBtn">
                                    <i class="fas fa-eye view-icon"></i>
                                    View File
                                </button>
                                @if (ViewBag.FileExists == true)
                                {
                                    <span class="file-size">@ViewBag.FileSize</span>
                                }
                                else
                                {
                                    <span class="no-file-message">File not found on server</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="no-file-message">No file uploaded</span>
                        }
                    </dd>
                </div>
            </dl>

            <div class="btn-container" id="btnContainer">
                <a href="@Url.Action("Index", "Patient")" class="btn btn-secondary wave-effect">
                    <i class="fas fa-arrow-left"></i>
                    Back to List
                </a>

                @if (Model?.Id != null && Model.Id > 0)
                {
                    <a href="@Url.Action("Edit", "Patient", new { id = Model.Id })" class="btn btn-secondary wave-effect">
                        <i class="fas fa-edit"></i>
                        Edit Patient
                    </a>
                }
            </div>
        </div>
    </div>

    <script>
        // Download file function
        async function downloadFile(patientId) {
            const downloadBtn = document.getElementById('downloadBtn');
            const originalContent = downloadBtn.innerHTML;

            if (!patientId) {
                alert('Patient ID not found');
                return;
            }

            try {
                // Add loading state
                downloadBtn.classList.add('btn-loading');
                downloadBtn.innerHTML = '<i class="fas fa-spinner"></i> Downloading...';

                // Create download URL
                const downloadUrl = '@Url.Action("DownloadFile", "Patient")?id=' + patientId;

                // Fetch the file
                const response = await fetch(downloadUrl);

                if (!response.ok) {
                    throw new Error(`Server error: ${response.status}`);
                }

                // Get filename from response headers
                const contentDisposition = response.headers.get('content-disposition');
                let filename = 'medical-file';

                if (contentDisposition) {
                    const filenameMatch = contentDisposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
                    if (filenameMatch && filenameMatch[1]) {
                        filename = filenameMatch[1].replace(/['"]/g, '');
                    }
                }

                // Convert response to blob
                const blob = await response.blob();

                // Create download link
                const url = window.URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = filename;
                link.style.display = 'none';

                // Trigger download
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                // Clean up
                window.URL.revokeObjectURL(url);

                // Show success state
                downloadBtn.classList.remove('btn-loading');
                downloadBtn.classList.add('btn-success-state');
                downloadBtn.innerHTML = '<i class="fas fa-check"></i> Downloaded Successfully';

                // Reset button after 3 seconds
                setTimeout(() => {
                    downloadBtn.classList.remove('btn-success-state');
                    downloadBtn.innerHTML = originalContent;
                }, 3000);

            } catch (error) {
                console.error('Download failed:', error);

                // Show error state
                downloadBtn.classList.remove('btn-loading');
                downloadBtn.classList.add('btn-error-state');
                downloadBtn.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Download Failed';

                // Reset button after 3 seconds
                setTimeout(() => {
                    downloadBtn.classList.remove('btn-error-state');
                    downloadBtn.innerHTML = originalContent;
                }, 3000);

                alert('Failed to download file: ' + error.message);
            }
        }

        // Create animated particles
        function createParticles() {
            const particlesContainer = document.querySelector('.particles');
            const particleCount = 50;

            for (let i = 0; i < particleCount; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                particle.style.width = Math.random() * 5 + 3 + 'px';
                particle.style.height = particle.style.width;
                particlesContainer.appendChild(particle);

                setInterval(() => {
                    if (Math.random() > 0.5) {
                        particle.classList.toggle('floating-up');
                        particle.classList.remove('floating-down');
                    } else {
                        particle.classList.toggle('floating-down');
                        particle.classList.remove('floating-up');
                    }
                }, Math.random() * 4000 + 2000);
            }
        }

        // Page load animation sequence
        function initializeAnimations() {
            const detailsContainer = document.getElementById('detailsContainer');
            const pageTitle = document.getElementById('pageTitle');
            const patientName = document.getElementById('patientName');
            const divider = document.getElementById('divider');
            const detailsList = document.getElementById('detailsList');
            const btnContainer = document.getElementById('btnContainer');

            setTimeout(() => detailsContainer.classList.add('loaded'), 100);
            setTimeout(() => pageTitle.classList.add('loaded'), 300);
            setTimeout(() => patientName.classList.add('loaded'), 500);
            setTimeout(() => divider.classList.add('loaded'), 700);
            setTimeout(() => detailsList.classList.add('loaded'), 900);
            setTimeout(() => btnContainer.classList.add('loaded'), 1100);
        }
            function viewFile(patientId) {
            if (!patientId) {
                alert('Patient ID not found');
                return;
            }
            const viewUrl = '@Url.Action("ViewFile", "Patient")?id=' + patientId;
            window.open(viewUrl, '_blank'); 
        }

        // Initialize everything when page loads
        document.addEventListener('DOMContentLoaded', function() {
            createParticles();
            initializeAnimations();
        });
    </script>
</body>
</html>