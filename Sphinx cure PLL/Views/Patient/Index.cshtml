@model List<Sphinx_cure_.BLL.ModelVM.Patient.PatientDTO>

@{
    ViewData["Title"] = "Patients";
}

<h2>Patients</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Add New Patient</a>
</p>

<!-- مربع البحث -->
<input type="text" id="searchBox" class="form-control mb-3" placeholder="Search by name" autocomplete="off" />

<!-- هنا هنعرض الاقتراحات -->
<ul id="suggestions" class="list-group" style="position:absolute; z-index:1000; width:300px;"></ul>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped" id="patientTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>File</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @await Html.PartialAsync("_PatientTable", Model)
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        // تحديث الجدول كل 3 ثواني
        function refreshPatientTable() {
            $.get('@Url.Action("GetPatientTable")', function (html) {
                $("#patientTable tbody").html(html);
            });
        }

        // الحذف
        function deletePatient(id, name) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to delete patient: " + name,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Patient/Delete/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (msg) {
                            Swal.fire('Deleted!', msg, 'success');
                            refreshPatientTable();
                        },
                        error: function (xhr) {
                            Swal.fire('Error', xhr.responseText || 'Delete failed', 'error');
                        }
                    });
                }
            });
        }

        $(document).ready(function () {
            // البحث اللحظي و إظهار أسماء تحت الـ input
            $("#searchBox").on("keyup", function () {
                var query = $(this).val().trim();

                if (query.length === 0) {
                    $("#suggestions").empty();
                    refreshPatientTable(); // يرجع الجدول كامل لما البحث يفضى
                    return;
                }

                $.ajax({
                    url: '@Url.Action("SearchNames", "Patient")',
                    type: 'GET',
                    data: { term: query },
                    success: function (data) {
                        $("#suggestions").empty();

                        if (data.length > 0) {
                            $.each(data, function (i, name) {
                                $("#suggestions").append(
                                    "<li class='list-group-item suggestion-item' style='cursor:pointer'>" + name + "</li>"
                                );
                            });
                        }
                    }
                });
            });

            // لما المستخدم يختار اسم من الليست
            $(document).on("click", ".suggestion-item", function () {
                var selectedName = $(this).text();
                $("#searchBox").val(selectedName);
                $("#suggestions").empty();

                // هنا نجيب الجدول بقى بالاسم المختار
                $.get('@Url.Action("Search", "Patient")', { name: selectedName }, function (html) {
                    $("#patientTable tbody").html(html);
                });
            });
        });

        // تحديث الجدول كل 3 ثواني
        setInterval(refreshPatientTable, 3000);
    </script>
}
