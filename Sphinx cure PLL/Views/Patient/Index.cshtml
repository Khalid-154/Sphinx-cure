@model List<Sphinx_cure_.BLL.ModelVM.Patient.PatientDTO>

@{
    ViewData["Title"] = "Patients";
}

<h2>Patients</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Add New Patient</a>
</p>

<!-- مربع البحث -->
<input type="text" id="searchBox" class="form-control mb-3" placeholder="Search by name" autocomplete="off" />

<!-- هنا هنعرض الاقتراحات -->
<ul id="suggestions" class="list-group" style="position:absolute; z-index:1000; width:300px;"></ul>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped" id="patientTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>File</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @await Html.PartialAsync("_PatientTable", Model)
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .build();

        connection.on("RefreshPatients", function (actionType) {
            refreshPatientTable();

            let toastConfig = {
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 2000,
                timerProgressBar: true,
                didOpen: (toast) => {
                    toast.onmouseenter = Swal.stopTimer;
                    toast.onmouseleave = Swal.resumeTimer;
                }
            };

            switch (actionType) {
                case "Create":
                    Swal.fire({ ...toastConfig, icon: 'success', title: 'New patient added' });
                    break;
                case "Update":
                    Swal.fire({ ...toastConfig, icon: 'info', title: 'Patient updated' });
                    break;
                case "Delete":
                    Swal.fire({ ...toastConfig, icon: 'error', title: 'Patient deleted' });
                    break;
                default:
                    Swal.fire({ ...toastConfig, icon: 'info', title: 'Patients list refreshed' });
                    break;
            }
        });

        connection.start().catch(err => console.error(err.toString()));

        function refreshPatientTable() {
            $.get('@Url.Action("GetPatientTable")', function (html) {
                $("#patientTable tbody").html(html);
            });
        }

        function deletePatient(id, name) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to delete patient: " + name,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Patient/Delete/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (msg) {
                            // هنا السيرفر نفسه هيبعت التوست (Delete)
                            console.log(msg);
                        },
                        error: function (xhr) {
                            Swal.fire('Error', xhr.responseText || 'Delete failed', 'error');
                        }
                    });
                }
            });
        }

        $(document).ready(function () {
            $("#searchBox").on("keyup", function () {
                var query = $(this).val().trim();

                if (query.length === 0) {
                    $("#suggestions").empty();
                    refreshPatientTable();
                    return;
                }

                $.ajax({
                    url: '@Url.Action("SearchNames", "Patient")',
                    type: 'GET',
                    data: { term: query },
                    success: function (data) {
                        $("#suggestions").empty();

                        if (data.length > 0) {
                            $.each(data, function (i, name) {
                                $("#suggestions").append(
                                    "<li class='list-group-item suggestion-item' style='cursor:pointer'>" + name + "</li>"
                                );
                            });
                        }
                    }
                });
            });

            $(document).on("click", ".suggestion-item", function () {
                var selectedName = $(this).text();
                $("#searchBox").val(selectedName);
                $("#suggestions").empty();

                $.get('@Url.Action("Search", "Patient")', { name: selectedName }, function (html) {
                    $("#patientTable tbody").html(html);
                });
            });
        });
    </script>
}