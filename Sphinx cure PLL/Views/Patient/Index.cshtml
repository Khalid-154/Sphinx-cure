@model List<Sphinx_cure_.BLL.ModelVM.Patient.PatientDTO>

@{
    ViewData["Title"] = "Patients";
}

<h2>Patients</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Add New Patient</a>
</p>

<form asp-action="Search" method="get" class="form-inline mb-3">
    <input type="text" name="name" class="form-control mr-2" placeholder="Search by name" />
    <button type="submit" class="btn btn-info">Search</button>
</form>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>


@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped" id="patientTable">
    <thead>
        <tr>
            <th>Name</th>
            <th>File</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @await Html.PartialAsync("_PatientTable", Model)
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        function refreshPatientTable() {
            $.get('@Url.Action("GetPatientTable")', function(html) {
                $("#patientTable tbody").html(html);
            });
        }

                function deletePatient(id, name) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to delete patient: " + name,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Patient/Delete/' + id,
                        type: 'POST',
                        data: {
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function(msg) {
                            Swal.fire('Deleted!', msg, 'success');
                            refreshPatientTable();
                        },
                        error: function(xhr) {
                            Swal.fire('Error', xhr.responseText || 'Delete failed', 'error');
                        }
                    });
                }
            });
        }


        // تحديث الجدول كل 3 ثواني
        setInterval(refreshPatientTable, 3000);
    </script>
}
