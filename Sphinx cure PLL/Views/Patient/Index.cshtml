@using Sphinx_cure_.BLL.ModelVM.Patient
@model List<PatientDTO>

@{
    ViewData["Title"] = "Patients";
}

<h2>Patients</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Add New Patient</a>
</p>

<form asp-action="Search" method="get" class="form-inline mb-3">
    <input type="text" name="name" class="form-control mr-2" placeholder="Search by name" />
    <button type="submit" class="btn btn-info">Search</button>
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var patient in Model)
        {
            <tr>
                <td>@patient.Name</td>
                <td>@patient.FilePath</td>
                <td>
                    <a class="btn btn-info btn-sm" asp-action="Details" asp-route-id="@patient.Id">Details</a>
                    <a class="btn btn-warning btn-sm" asp-action="Edit" asp-route-id="@patient.Id">Edit</a>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@patient.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
