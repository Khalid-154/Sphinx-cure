@model IEnumerable<Sphinx_cure_.DAL.Entities.User>

@{
    ViewData["Title"] = "User Management";
}

<h2>User Management</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Create New User</a>
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Username</th>
            <th>Role</th>
            <th>Created At</th>
            @if (ViewBag.IsAdmin == true)
            {
                <th>Actions</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Role</td>
                <td>@user.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                @if (ViewBag.IsAdmin == true)
                {
                    <td>
                        <a href="@Url.Action("EditUser", "UserManagement", new { userId = user.Id })" class="btn btn-info btn-sm">Edit</a>
                        <form asp-action="ResetPassword" method="post" style="display: inline; margin-left: 10px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id" />
                            <input type="password" name="newPassword" placeholder="New Password" required style="width: 150px;" />
                            <button type="submit" class="btn btn-warning btn-sm">Reset Password</button>
                        </form>
                        <form asp-action="DeleteUser" method="post" style="display: inline; margin-left: 10px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this user?')">Delete</button>
                        </form>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
