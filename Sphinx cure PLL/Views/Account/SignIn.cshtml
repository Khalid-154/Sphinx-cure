@model Sphinx_cure_.BLL.ModelVM.Account.LoginVM
@{
    ViewData["Title"] = "Login";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card shadow border-0 rounded-4 bg-light">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 text-dark fw-bold">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </h3>

                    <form asp-action="SignIn" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">User Name</label>
                            <input asp-for="UserName" class="form-control" placeholder="Enter user name" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>


                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="Enter password" type="password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 py-2">
                            <i class="bi bi-box-arrow-in-right"></i> Sign In
                        </button>
                    </form>

                    <hr />

                    <div class="text-center">
                        <span class="text-muted">Don’t have an account?</span>
                        <a asp-action="SignUp" asp-controller="Account" class="text-decoration-none">
                            <strong>Register</strong>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
