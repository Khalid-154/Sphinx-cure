@model Sphinx_cure_.BLL.ModelVM.Account.RegisterVM
@{
    ViewData["Title"] = "Register";
    Layout = "_LoginLayout";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4">
                    <h3 class="text-center mb-4 text-primary fw-bold">
                        <i class="bi bi-person-plus"></i> Create Account
                    </h3>

                    <form asp-action="SignUp" method="post">
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label">User Name</label>
                            <input asp-for="UserName" class="form-control" placeholder="Enter username" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            <i class="bi bi-person-plus"></i> Sign Up
                        </button>
                    </form>

                    <hr />

                    <div class="text-center">
                        <span class="text-muted">Already have an account?</span>
                        <a asp-action="SignIn" asp-controller="Account" class="text-decoration-none">
                            <strong>Login</strong>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
