        .docmed-signup, .docmed-login {
            max-width: 500px;
            margin-top: 0;
            margin-bottom: 34px;
            margin-inline: auto;
            padding-block: 2rem;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 123, 255, 0.25);
        }

        .docmed-logo {
            text-align: center;
            margin-bottom: 1.5rem;
            color: #0d6efd;
