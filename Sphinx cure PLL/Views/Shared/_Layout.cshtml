            padding-inline: 2rem;
        }

        .form-control {
            padding-right: 40px;
        }

        .section-hidden {
            opacity: 0;
            height: 0;
            overflow: hidden;
            transform: translateX(-50px);
            pointer-events: none;
        }

        .section-visible {
            opacity: 1;
            height: auto;
            transform: translateX(0);
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .btn-docmed-primary {
