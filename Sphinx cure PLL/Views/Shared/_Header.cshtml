@{
    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
}

<nav class="navbar navbar-expand-lg navbar-light medical-header">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <img src="~/img/logo.jpg" alt="Sphinx Cure Medical Clinic Logo" style="height: 40px; margin-right: 10px;">
            Sphinx Cure Medical Clinic
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                        <i class="fas fa-home"></i> Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Patient" && currentAction == "Index" ? "active" : "")"
                       asp-controller="Patient" asp-action="Index">
                        <i class="fas fa-users"></i> All Patients
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Patient" && currentAction == "Create" ? "active" : "")"
                       asp-controller="Patient" asp-action="Create">
                        <i class="fas fa-user-plus"></i> Add Patient
                    </a>
                </li>

                @if (!User.Identity.IsAuthenticated)
                {
                    <!-- زرار Login -->
                    <li class="nav-item">
                        <a class="btn btn-outline-primary ms-2 @(currentController == "Account" && currentAction == "SignIn" ? "active" : "")"
                           asp-controller="Account" asp-action="SignIn">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    </li>

                    <!-- زرار Register -->
                    <li class="nav-item">
                        <a class="btn btn-primary ms-2 @(currentController == "Account" && currentAction == "SignUp" ? "active" : "")"
                           asp-controller="Account" asp-action="SignUp">
                            <i class="fas fa-user-plus"></i> Register
                        </a>
                    </li>
                }
                else
                {
                    <!-- Notification Bell -->
                    <li class="nav-item">
                        <a class="nav-link position-relative" href="#" id="notificationBell">
                            <i class="fas fa-bell"></i>
                            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle" id="notificationBadge" style="display: none;">0</span>
                        </a>
                    </li>

                    <!-- Logout Button -->
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger ms-2">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<style>
    .nav-link.active,
    .btn.active {
        background: linear-gradient(45deg, #2c5aa0, #3742fa);
        color: white !important;
        box-shadow: 0 5px 15px rgba(44, 90, 160, 0.4);
        border-radius: 25px;
    }
</style>
