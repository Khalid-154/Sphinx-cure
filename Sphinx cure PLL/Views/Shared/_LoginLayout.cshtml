<!doctype html>
<html class="no-js" lang="zxx">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@ViewData["Title"] - Sphinx Cure Medical Clinic</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="img/favicon.png">

    <!-- CSS Files -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/owl.carousel.min.css">
    <link rel="stylesheet" href="~/css/magnific-popup.css">

    <!-- Icon Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Template CSS -->
    <link rel="stylesheet" href="~/css/gijgo.css">
    <link rel="stylesheet" href="~/css/animate.css">
    <link rel="stylesheet" href="~/css/slicknav.css">
    <link rel="stylesheet" href="~/css/style.css">

    <!-- Login CSS -->
    <link rel="stylesheet" href="https://unpkg.com/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://unpkg.com/bs-brain@2.0.4/components/logins/login-4/assets/css/login-4.css">

    <!-- Profile CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        .form-link, .reset-password-link {
            margin-bottom: 0;
            font-size: small;
        }

        .form-link {
            display: inline-block;
            margin-right: 10px;
            margin-top: 10px;
            margin-bottom: 0;
        }

        .reset-password-link {
            margin-bottom: 20px;
        }

        .a-btn {
            text-decoration: none;
        }

        .docmed-signup, .docmed-login {
            max-width: 500px;
            margin-top: 0;
            margin-bottom: 34px;
            margin-inline: auto;
            padding-block: 2rem;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0, 123, 255, 0.25);
        }

        .docmed-logo {
            text-align: center;
            margin-bottom: 1.5rem;
            color: #0d6efd;
            font-weight: bold;
            font-size: 2rem;
        }

        .form-section {
            transition: all 0.4s ease-in-out;
            overflow: hidden;
        }

        .form-header {
            text-align: center;
        }

        .form-check-field {
            padding-inline: 3rem;
        }

        .form-input, #error-display, #show-error, .signup-link, .login-link, .reset-password-link {
            padding-inline: 2rem;
        }

        .form-control {
            padding-right: 40px;
        }

        .section-hidden {
            opacity: 0;
            height: 0;
            overflow: hidden;
            transform: translateX(-50px);
            pointer-events: none;
        }

        .section-visible {
            opacity: 1;
            height: auto;
            transform: translateX(0);
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .btn-docmed-primary {
            background-color: #0d6efd;
            border-color: #0d6efd;
            padding: 0.5rem 2rem;
        }

        .btn-docmed-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
            padding: 0.5rem 2rem;
        }

        .password-toggle {
            cursor: pointer;
            position: absolute;
            right: 42px;
            top: 70%;
            transform: translateY(-50%);
        }

        .nav-link.active {
            background: linear-gradient(45deg, #2c5aa0, #3742fa);
            color: white !important;
            box-shadow: 0 5px 15px rgba(44, 90, 160, 0.4);
            border-radius: 25px;
        }
    </style>
</head>

<body>
    <!--[if lte IE 9]>
        <p class="browserupgrade">You are using an <strong>outdated</strong> browser. Please <a href="https://browsehappy.com/">upgrade your browser</a> to improve your experience and security.</p>
    <![endif]-->

    <!-- Main Content -->
    @RenderBody()

    <!-- JavaScript Files -->
    <!-- jQuery FIRST (required for all jQuery plugins) -->
    <script src="~/js/vendor/jquery-1.12.4.min.js"></script>

    <!-- Other JS files -->
    <script src="~/js/vendor/modernizr-3.5.0.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/owl.carousel.min.js"></script>
    <script src="~/js/isotope.pkgd.min.js"></script>
    <script src="~/js/ajax-form.js"></script>
    <script src="~/js/waypoints.min.js"></script>
    <script src="~/js/jquery.counterup.min.js"></script>
    <script src="~/js/imagesloaded.pkgd.min.js"></script>
    <script src="~/js/scrollIt.js"></script>
    <script src="~/js/jquery.scrollUp.min.js"></script>
    <script src="~/js/wow.min.js"></script>
    <script src="~/js/nice-select.min.js"></script>
    <script src="~/js/jquery.slicknav.min.js"></script>
    <script src="~/js/jquery.magnific-popup.min.js"></script>
    <script src="~/js/plugins.js"></script>
    <script src="~/js/gijgo.min.js"></script>

    <!-- Profile JS -->
    <script src="https://unpkg.com/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Contact JS -->
    <script src="~/js/contact.js"></script>
    <script src="~/js/jquery.ajaxchimp.min.js"></script>
    <script src="~/js/jquery.form.js"></script>
    <script src="~/js/jquery.validate.min.js"></script>
    <script src="~/js/mail-script.js"></script>

    <script src="~/js/main.js"></script>

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- Page-specific scripts (Login/Register validation scripts will load here) -->
    @RenderSection("Scripts", required: false)

    <!-- Template Scripts -->
    <script>
        $(document).ready(function() {
            // Datepicker initialization
            $('#datepicker').datepicker({
                iconsLibrary: 'fontawesome',
                icons: {
                    rightIcon: '<span class="fa fa-caret-down"></span>'
                }
            });

            $('#datepicker2').datepicker({
                iconsLibrary: 'fontawesome',
                icons: {
                    rightIcon: '<span class="fa fa-caret-down"></span>'
                }
            });

            // Select2 initialization
            $('.js-example-basic-multiple').select2();

            // Set max date for birth date input
            const birthDateInput = document.getElementById('BirthDate');
            if (birthDateInput) {
                birthDateInput.max = new Date().toISOString().split('T')[0];
            }
        });

        // Toggle password visibility
        function togglePassword(inputId) {
            const passwordInput = document.getElementById(inputId);
            if (!passwordInput) return;

            const toggleIcon = passwordInput.nextElementSibling?.querySelector('i');
            if (!toggleIcon) return;

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        }

        // Validate birth date
        function validateBirthDate() {
            const birthDateInput = document.getElementById('BirthDate');
            if (!birthDateInput) return true;

            const selectedDate = new Date(birthDateInput.value);
            const today = new Date();

            if (selectedDate > today) {
                alert("Birth date cannot be in the future.");
                birthDateInput.value = '';
                return false;
            }
            return true;
        }
    </script>
</body>
</html>
